# Copy to `.env.frames-production.local`; this file is only for the guarded local
# frame-promotion command. Do not point routine development commands at these values.
PRODUCTION_TARGET_LABEL="frieren-production"
PRODUCTION_DATABASE_URL="postgresql://USER:PASSWORD@PRODUCTION_HOST/DATABASE?sslmode=require"

PRODUCTION_R2_ACCOUNT_ID=""
PRODUCTION_R2_ACCESS_KEY_ID=""
PRODUCTION_R2_SECRET_ACCESS_KEY=""
PRODUCTION_R2_BUCKET=""
PRODUCTION_R2_PUBLIC_BASE_URL="https://frames.example.com"
