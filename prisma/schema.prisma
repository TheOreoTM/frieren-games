generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FrameDifficulty {
  EASY
  MEDIUM
  HARD
}

enum UserRole {
  USER
  ADMIN
}

enum DailyChallengeStatus {
  DRAFT
  APPROVED
  VOID
}

enum ConnectionsPuzzleStatus {
  DRAFT
  APPROVED
  VOID
}

enum ConnectionsSubmissionResult {
  CORRECT
  INCORRECT
}

enum XPSource {
  DAILY_COMPLETION
  DAILY_PERFORMANCE
  UNLIMITED_COMPLETION
  ACHIEVEMENT
}

model User {
  id    String  @id @default(cuid())
  name  String?
  image String?

  username    String?   @unique
  displayName String?
  onboardedAt DateTime?
  role        UserRole  @default(USER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  dailyAttempts       DailyAttempt[]
  unlimitedAttempts   UnlimitedAttempt[]
  xpTransactions      XPTransaction[]
  achievements        UserAchievement[]
  connectionsAttempts ConnectionsAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Episode {
  id               Int                   @id @default(autoincrement())
  season           Int
  episodeNumber    Int
  globalOrder      Int                   @unique
  title            String
  durationMs       Int?
  frames           Frame[]
  dailyGuesses     DailyRoundGuess[]     @relation("DailyGuessedEpisode")
  unlimitedGuesses UnlimitedRoundGuess[] @relation("UnlimitedGuessedEpisode")

  @@unique([season, episodeNumber])
}

model Frame {
  id          String          @id
  episodeId   Int
  episode     Episode         @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  timestampMs Int
  difficulty  FrameDifficulty
  objectKey   String          @unique
  width       Int
  height      Int
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  dailyRounds      DailyChallengeRound[]
  dailyGuesses     DailyRoundGuess[]
  unlimitedGuesses UnlimitedRoundGuess[]

  @@index([episodeId, enabled])
  @@index([difficulty, enabled])
}

model DailyChallenge {
  id         String               @id @default(cuid())
  dateUtc    DateTime             @unique @db.Date
  status     DailyChallengeStatus @default(DRAFT)
  approvedAt DateTime?
  voidedAt   DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  rounds   DailyChallengeRound[]
  attempts DailyAttempt[]
}

model DailyChallengeRound {
  id          String @id @default(cuid())
  challengeId String
  roundNumber Int
  frameId     String @unique

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  frame     Frame          @relation(fields: [frameId], references: [id], onDelete: Restrict)

  @@unique([challengeId, roundNumber])
  @@unique([challengeId, frameId])
  @@index([challengeId])
}

model DailyAttempt {
  id           String    @id @default(cuid())
  userId       String
  challengeId  String
  ranked       Boolean
  currentRound Int       @default(0)
  totalScore   Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge    @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  guesses   DailyRoundGuess[]
  // A partial unique index in the migration enforces one ranked attempt per user/challenge.

  @@index([userId, challengeId, ranked])
  @@index([challengeId, ranked, completedAt, totalScore])
}

model DailyRoundGuess {
  id               String   @id @default(cuid())
  attemptId        String
  roundNumber      Int
  frameId          String
  guessedEpisodeId Int
  distance         Int
  score            Int
  createdAt        DateTime @default(now())

  attempt        DailyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  frame          Frame        @relation(fields: [frameId], references: [id], onDelete: Restrict)
  guessedEpisode Episode      @relation("DailyGuessedEpisode", fields: [guessedEpisodeId], references: [id], onDelete: Restrict)

  @@unique([attemptId, roundNumber])
  @@index([frameId])
  @@index([guessedEpisodeId])
}

model UnlimitedAttempt {
  id          String   @id
  userId      String
  totalScore  Int
  completedAt DateTime @default(now())

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses UnlimitedRoundGuess[]

  @@index([userId, completedAt])
  @@index([userId, totalScore])
}

model UnlimitedRoundGuess {
  id               String @id @default(cuid())
  attemptId        String
  roundNumber      Int
  frameId          String
  guessedEpisodeId Int
  distance         Int
  score            Int

  attempt        UnlimitedAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  frame          Frame            @relation(fields: [frameId], references: [id], onDelete: Restrict)
  guessedEpisode Episode          @relation("UnlimitedGuessedEpisode", fields: [guessedEpisodeId], references: [id], onDelete: Restrict)

  @@unique([attemptId, roundNumber])
  @@index([frameId])
  @@index([guessedEpisodeId])
}

model XPTransaction {
  id            String   @id @default(cuid())
  userId        String
  source        XPSource
  sourceKey     String
  amount        Int
  earnedDateUtc DateTime @db.Date
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceKey])
  @@index([userId, createdAt])
  @@index([userId, source, earnedDateUtc])
}

model Achievement {
  id String @id

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@id([userId, achievementId])
  @@index([achievementId])
}

model ConnectionsPuzzle {
  id          String                  @id @default(cuid())
  dateUtc     DateTime                @unique @db.Date
  status      ConnectionsPuzzleStatus @default(DRAFT)
  spoilerNote String?
  approvedAt  DateTime?
  voidedAt    DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  groups   ConnectionsGroup[]
  attempts ConnectionsAttempt[]
}

model ConnectionsGroup {
  id          String  @id @default(cuid())
  puzzleId    String
  position    Int
  label       String
  explanation String?

  puzzle             ConnectionsPuzzle       @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  tiles              ConnectionsTile[]
  matchedSubmissions ConnectionsSubmission[]

  @@unique([id, puzzleId])
  @@unique([puzzleId, position])
  @@index([puzzleId])
}

model ConnectionsTile {
  id             String @id @default(cuid())
  groupId        String
  puzzleId       String
  text           String
  normalizedText String

  group           ConnectionsGroup            @relation(fields: [groupId, puzzleId], references: [id, puzzleId], onDelete: Cascade)
  submissionTiles ConnectionsSubmissionTile[]

  @@unique([puzzleId, normalizedText])
  @@index([groupId, puzzleId])
}

model ConnectionsAttempt {
  id          String    @id @default(cuid())
  puzzleId    String
  userId      String
  ranked      Boolean
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  failedAt    DateTime?

  puzzle      ConnectionsPuzzle       @relation(fields: [puzzleId], references: [id], onDelete: Restrict)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions ConnectionsSubmission[]
  // A partial unique index in the migration enforces one ranked attempt per user/puzzle.

  @@index([userId, puzzleId, ranked])
  @@index([puzzleId, ranked, completedAt, failedAt])
}

model ConnectionsSubmission {
  id             String                      @id @default(cuid())
  attemptId      String
  sequence       Int
  result         ConnectionsSubmissionResult
  matchedGroupId String?
  oneAway        Boolean                     @default(false)
  createdAt      DateTime                    @default(now())

  attempt      ConnectionsAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  matchedGroup ConnectionsGroup?           @relation(fields: [matchedGroupId], references: [id], onDelete: Restrict)
  tiles        ConnectionsSubmissionTile[]

  @@unique([attemptId, sequence])
  @@index([matchedGroupId])
}

model ConnectionsSubmissionTile {
  submissionId String
  tileId       String

  submission ConnectionsSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tile       ConnectionsTile       @relation(fields: [tileId], references: [id], onDelete: Restrict)

  @@id([submissionId, tileId])
  @@index([tileId])
}
